# ==============================================================================
# AutoPage SaaS — Production Environment Variables for Vercel
# ==============================================================================

# 1. MongoDB Atlas Database Connection (Required for Vercel Serverless)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/fb_page_automation?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.51crwlq.mongodb.net/fb_page_automation?retryWrites=true&w=majority

# 2. Meta Facebook Graph API & Webhook Configuration
# Verify Token set in Meta App Dashboard > Webhooks > Page
META_WEBHOOK_VERIFY_TOKEN=fb_auto_verify_token_secure_2025
NEXT_PUBLIC_META_WEBHOOK_VERIFY_TOKEN=fb_auto_verify_token_secure_2025

# Meta App Secret from Meta App Dashboard > App Settings > Basic (Optional for signature validation)
META_APP_SECRET=

# 3. Vercel Cron Job Security Secret (Used by Vercel Cron to trigger /api/cron/publish)
CRON_SECRET=cron_scheduler_secret_token_secure_2026

# 4. Public Application Base URL (Set to your live Vercel domain or custom domain)
# e.g., https://autopage-saas.vercel.app
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 5. Google Gemini AI Salesman API Key (Optional for live Gemini 1.5 Flash fallback)
# If empty, AutoPage automatically uses the built-in Smart Bengali/Banglish Contextual Simulator
GEMINI_API_KEY=
