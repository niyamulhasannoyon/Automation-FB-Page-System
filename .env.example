# ==============================================================================
# AutoPage SaaS — Production Environment Configuration (.env.example)
# ==============================================================================

# 1. MongoDB Database Connection (Atlas or Self-Hosted)
# Automatically uses local JSON store (.data/db.json) if MongoDB is offline.
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/autopage_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/autopage_db?retryWrites=true&w=majority

# 2. Security & Token Encryption at Rest (AES-256-GCM)
# Must be a 32-byte hex string (64 hex characters) or a high-entropy secret string.
# Generate in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. Session Authentication & Multi-Tenant JWT Secret
# Secret key used for signing lightweight JWT auth cookies for merchant sessions.
JWT_SECRET=super_secure_jwt_session_secret_token_autopage_2026

# 4. Meta Facebook Graph API & Webhook Hardening
# Verify Token set inside Meta App Dashboard > Webhooks > Page
META_WEBHOOK_VERIFY_TOKEN=fb_auto_verify_token_secure_2025
NEXT_PUBLIC_META_WEBHOOK_VERIFY_TOKEN=fb_auto_verify_token_secure_2025

# Meta App ID and App Secret (from Meta Developer Dashboard > App Settings > Basic)
# Required for HMAC sha256 webhook signature validation and 1-Click Facebook OAuth.
META_APP_ID=
META_APP_SECRET=

# 5. Google Gemini AI Salesman API Key (Gemini 2.5 Flash)
# If empty, AutoPage seamlessly activates the built-in Smart Bengali Contextual Sales Engine.
GEMINI_API_KEY=

# 6. Vercel Cron Job Security Secret
# Passed in Authorization header by Vercel Cron when executing /api/cron/publish.
CRON_SECRET=cron_scheduler_secret_token_secure_2026

# 7. Public Application Base URL
# Live domain used for Webhook callback & OAuth redirects (e.g. https://autopage.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 8. Media Upload & CDN (Cloudinary - Optional)
# If provided, drag-and-drop media uploads to Cloudinary CDN; otherwise falls back to Base64/local storage.
# Example: cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyza@my-cloud
CLOUDINARY_URL=
